NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_vmYiwE2uJ0bj-lM0a4oCRg_IdVe0hig
# Required for the Resend fallback in /api/auth/magic-link (admin.generateLink).
# Find it in the Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Resend backup email channel — used when Supabase email send fails (rate-limit
# or SMTP outage). Get an API key at https://resend.com and verify a sender
# domain. RESEND_FROM_EMAIL must match a verified sender, e.g. "commute.vn <login@your-domain.com>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
PORT=4000
